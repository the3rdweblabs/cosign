# Which BOT Chain network the console targets. Vite only exposes VITE_-prefixed
# vars to the browser, so the selector is VITE_BOT_NETWORK and per-network
# config is suffixed (VITE_BOT_RPC_URL_TESTNET / VITE_BOT_RPC_URL_MAINNET, ...).
VITE_BOT_NETWORK=testnet

# BOT Chain testnet (chain 968)
VITE_BOT_RPC_URL_TESTNET=https://rpc.bohr.life
# BOT Chain mainnet (chain 677)
VITE_BOT_RPC_URL_MAINNET=https://rpc.botchain.ai

# Deployed contract addresses (per network, from the deploy script output)
# testnet live (chain 968): AgentRegistry 0x0cA3F183374f75e5a2d81C29A37B00Aab075be87,
# ConsentGateway 0xAc1813a52D1d3b6fFf0080feD17362C8aD86F372
VITE_AGENT_REGISTRY_ADDRESS_TESTNET=0x0cA3F183374f75e5a2d81C29A37B00Aab075be87
VITE_AGENT_REGISTRY_ADDRESS_MAINNET=
VITE_CONSENT_GATEWAY_ADDRESS_TESTNET=0xAc1813a52D1d3b6fFf0080feD17362C8aD86F372
VITE_CONSENT_GATEWAY_ADDRESS_MAINNET=

# Earliest block to backfill consent events from (0 = genesis)
VITE_FROM_BLOCK_TESTNET=0
VITE_FROM_BLOCK_MAINNET=0
