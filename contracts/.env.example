# Which BOT Chain network to deploy to: testnet (default) or mainnet.
# The deploy script refuses to run if the --rpc-url chain id does not match
# this (968 = testnet, 677 = mainnet). Writes deploy.{BOT_NETWORK}.json.
BOT_NETWORK=testnet

# Private key of the deployer EOA used by script/Deploy.s.sol (vm.envUint).
# The account must hold gas on the network you deploy to:
#   - testnet (chain 968): fund with tBOT from the faucet
#   - mainnet (chain 677): fund with BOT directly
# Set it in your shell or let forge load it from a .env file.
DEPLOYER_PRIVATE_KEY=
