# Which BOT Chain network to target: testnet (default) or mainnet.
# Network-specific config vars are suffixed with _TESTNET / _MAINNET and read
# per BOT_NETWORK (e.g. BOT_RPC_URL_TESTNET when BOT_NETWORK=testnet). The
# unsuffixed form (e.g. BOT_RPC_URL) still works as a single-network fallback.
BOT_NETWORK=testnet

# BOT Chain testnet (chain 968)
BOT_RPC_URL_TESTNET=https://rpc.bohr.life
# BOT Chain mainnet (chain 677)
BOT_RPC_URL_MAINNET=https://rpc.botchain.ai

# Deployed contracts (per network, from Deploy.s.sol output)
# testnet live (chain 968): ConsentGateway 0xAc1813a52D1d3b6fFf0080feD17362C8aD86F372
CONSENT_GATEWAY_ADDRESS_TESTNET=0xAc1813a52D1d3b6fFf0080feD17362C8aD86F372
CONSENT_GATEWAY_ADDRESS_MAINNET=

# The agent's signing key (EOA that must be registered in AgentRegistry)
AGENT_PRIVATE_KEY=

# The paid resource endpoints this agent drives (picked by task keywords):
# hubot/pickup/robot -> /hubot-task (consent-gated), market/report -> /market-report (pure x402).
# RESOURCE_URL overrides the routing when set (single-endpoint setups).
RESOURCE_URL=
HUBOT_TASK_URL=http://localhost:4000/hubot-task
MARKET_REPORT_URL=http://localhost:4000/market-report

# The facilitator that verifies/settles the payment (also advertises its fee)
FACILITATOR_URL=http://localhost:3000

# Task prompt when not passed as argv. Leave unset to start an interactive
# session: type a task at the `agent>` prompt (e.g. "get market report",
# "dispatch hubot pickup") and the agent runs it, until you type "quit" or
# press Ctrl-D.
TASK=

# LLM provider for the reasoning layer
# Which provider to reason with: anthropic (default), openai, google, deepseek,
# cerebras, or groq. The API key is read from any one of ANTHROPIC_API_KEY /
# OPENAI_API_KEY / GOOGLE_API_KEY / DEEPSEEK_API_KEY / CEREBRAS_API_KEY /
# GROQ_API_KEY / API_KEY, so you can set whichever you have.
PROVIDER=anthropic

# Optional: override the provider's base URL with a compatible proxy/endpoint.
# BASE_ANTHROPIC_URL=https://api.anthropic.com
# BASE_OPENAI_URL=https://api.openai.com/v1
# BASE_GOOGLE_URL=https://generativelanguage.googleapis.com/v1beta
# BASE_DEEPSEEK_URL=https://api.deepseek.com
# BASE_CEREBRAS_URL=https://api.cerebras.ai/v1
# BASE_GROQ_URL=https://api.groq.com/openai/v1

# Provider API keys (any one of these works; only your provider's is used)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=

# Model overrides (optional; sane defaults per provider)
CLAUDE_MODEL=claude-opus-5
OPENAI_MODEL=
GOOGLE_MODEL=
DEEPSEEK_MODEL=deepseek-v4-flash
CEREBRAS_MODEL=gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-20b

# JSONL activity log the console ActivityFeed can read
ACTIVITY_LOG=./activity.log