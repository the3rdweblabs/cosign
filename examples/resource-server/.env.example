# Which BOT Chain network to target: testnet (default) or mainnet.
# The payment network advertised in the 402 response is read per BOT_NETWORK:
# RESOURCE_NETWORK_TESTNET / RESOURCE_NETWORK_MAINNET (fallback: RESOURCE_NETWORK).
BOT_NETWORK=testnet

# Payment network advertised in the 402 (CAIP-2)
RESOURCE_NETWORK_TESTNET=eip155:968
RESOURCE_NETWORK_MAINNET=eip155:677

# Recipient of the payment (the "pay to" address for this paid API)
RESOURCE_PAYTO=

# Price for one HuBot pickup task, in wei of native BOT (18 decimals).
# Default per network: 1 tBOT on testnet, 0.1 BOT on mainnet.
# Per-network override wins: HUBOT_TASK_PRICE_TESTNET / HUBOT_TASK_PRICE_MAINNET
# (fallback: HUBOT_TASK_PRICE). 1 tBOT = 1000000000000000000, 0.1 BOT = 100000000000000000.
#
# POLICY NOTE: the reference agent is registered with a 2 tBOT / 24h spend cap,
# so the 1 tBOT default is IN-POLICY -> auto-approved when the agent runs
# (Scenario A). To exercise the guardian-gated path (Scenario B: the request
# parks as Pending until the guardian approves/rejects), raise the price above
# the cap and uncomment one of the TESTNET overrides below.
# Only one HUBOT_TASK_PRICE_TESTNET line may be active - uncomment exactly one:
#   2  tBOT = 2000000000000000000   (== cap -> Pending, guardian decides)
#   4  tBOT = 4000000000000000000
#   5  tBOT = 5000000000000000000
#   10 tBOT = 10000000000000000000
HUBOT_TASK_PRICE_TESTNET=1000000000000000000
#HUBOT_TASK_PRICE_TESTNET=2000000000000000000
#HUBOT_TASK_PRICE_TESTNET=4000000000000000000
#HUBOT_TASK_PRICE_TESTNET=5000000000000000000
#HUBOT_TASK_PRICE_TESTNET=10000000000000000000
HUBOT_TASK_PRICE_MAINNET=100000000000000000

# The separate facilitator process (paymaster RPC + x402 /verify /settle)
FACILITATOR_URL=http://localhost:3000

# Resource server listener
RESOURCE_PORT=4000
