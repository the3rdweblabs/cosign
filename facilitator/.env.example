# Which BOT Chain network to target: testnet (default) or mainnet.
# Network-specific config vars are suffixed with _TESTNET / _MAINNET and read
# per BOT_NETWORK (e.g. BOT_RPC_URL_TESTNET when BOT_NETWORK=testnet). The
# unsuffixed form (e.g. BOT_RPC_URL) still works as a single-network fallback.
BOT_NETWORK=testnet

# BOT Chain testnet (chain 968)
BOT_RPC_URL_TESTNET=https://rpc.bohr.life
CHAIN_ID_TESTNET=968
# BOT Chain mainnet (chain 677)
BOT_RPC_URL_MAINNET=https://rpc.botchain.ai
CHAIN_ID_MAINNET=677

# Deployed contracts (per network, from Deploy.s.sol output)
# testnet live (chain 968): AgentRegistry 0x0cA3F183374f75e5a2d81C29A37B00Aab075be87,
# ConsentGateway 0xAc1813a52D1d3b6fFf0080feD17362C8aD86F372
AGENT_REGISTRY_ADDRESS_TESTNET=0x0cA3F183374f75e5a2d81C29A37B00Aab075be87
AGENT_REGISTRY_ADDRESS_MAINNET=
CONSENT_GATEWAY_ADDRESS_TESTNET=0xAc1813a52D1d3b6fFf0080feD17362C8aD86F372
CONSENT_GATEWAY_ADDRESS_MAINNET=

# First block scanned when resolving pm_isSponsorable against the ConsentGateway's
# own ActionRequested logs (fast path: the gateway's deploy block). Per-network
# suffix supported: CONSENT_GATEWAY_FROM_BLOCK_TESTNET / _MAINNET. 0 = genesis.
# testnet live: gateway deployed at block 7365146.
CONSENT_GATEWAY_FROM_BLOCK_TESTNET=7365146
CONSENT_GATEWAY_FROM_BLOCK_MAINNET=0

# Settlement backend: 0 (default) = self-pay via public RPC, 1 = native paymaster (opt-in)
# Default path is self-pay: the demo must not depend on unproven bundle infra.
PAYMASTER_ENABLED=0

# Sponsor EOA that pays gas in the sponsor tx of each bundle.
# ONLY required when PAYMASTER_ENABLED=1 - in self-pay mode (default) the
# facilitator starts without it and eth_sendRawTransaction returns a clear
# "Sponsor not configured" error.
SPONSOR_PRIVATE_KEY=

# Facilitator surcharge (fee charged to the CLIENT on top of the resource price,
# collected as a second transfer to FEE_RECEIVER). 0 = no fee.
# Per-network suffix supported: FEE_BPS_TESTNET, FEE_RECEIVER_MAINNET, etc.
FEE_BPS=0
# FEE_PERCENT=0.01    # alternative: percentage as a number (0.01 = 0.01%)
FEE_RECEIVER=

# Paymaster JSON-RPC + x402 HTTP listener
PAYMASTER_PORT=3000
