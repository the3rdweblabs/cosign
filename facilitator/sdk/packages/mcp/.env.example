# Configuration for the xBOT02 MCP servers (cli/agent.js, cli/guardian.js).
# The same vars work for both servers; the guardian server additionally uses
# FROM_BLOCK. Normally these are set in your MCP client's server config rather
# than a .env, but this documents every option.

# Which BOT Chain network to target: testnet (default) or mainnet.
# Contract addresses / RPC may be suffixed _TESTNET / _MAINNET (fallback:
# the unsuffixed form).
BOT_NETWORK=testnet

# Chain read RPC (per network, or unsuffixed fallback)
BOT_RPC_URL_TESTNET=https://rpc.bohr.life
BOT_RPC_URL_MAINNET=https://rpc.botchain.ai

# Deployed contracts (per network)
# testnet live (chain 968): AgentRegistry 0x0cA3F183374f75e5a2d81C29A37B00Aab075be87,
# ConsentGateway 0xAc1813a52D1d3b6fFf0080feD17362C8aD86F372
CONSENT_GATEWAY_ADDRESS_TESTNET=0xAc1813a52D1d3b6fFf0080feD17362C8aD86F372
CONSENT_GATEWAY_ADDRESS_MAINNET=
AGENT_REGISTRY_ADDRESS_TESTNET=0x0cA3F183374f75e5a2d81C29A37B00Aab075be87
AGENT_REGISTRY_ADDRESS_MAINNET=

# Wallet: private-key (default), mnemonic, or json-rpc
WALLET_KIND=private-key
AGENT_PRIVATE_KEY=
# WALLET_KIND=mnemonic   -> AGENT_MNEMONIC=[+ WALLET_ACCOUNT_INDEX]
# WALLET_KIND=json-rpc   -> WALLET_ADDRESS= + WALLET_RPC= (signing RPC)

# Guardian server only: earliest block to backfill consent events from.
# Read as FROM_BLOCK_TESTNET / FROM_BLOCK_MAINNET (fallback: FROM_BLOCK).
FROM_BLOCK_TESTNET=0
FROM_BLOCK_MAINNET=0

# Optional: the facilitator base URL (required for the agent's pay_uri tool)
FACILITATOR_URL=http://localhost:3000
